<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- v6：深色背景+白字+内边距，确保输入文字可见 -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="场景名称（如：真人验证）"
        android:textColor="#FFFFFF"
        android:textColorHint="#9E9E9E"
        android:background="#2D2D2D"
        android:padding="12dp"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/etMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="屏幕出现的关键文字，如：继续学习"
        android:textColor="#FFFFFF"
        android:textColorHint="#9E9E9E"
        android:background="#2D2D2D"
        android:padding="12dp"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="点击方式"
        android:textColor="#BDBDBD"
        android:textSize="13sp" />

    <Spinner
        android:id="@+id/spinnerAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="指定坐标（选择「点击指定坐标」时生效）"
        android:textColor="#BDBDBD"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/etX"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="X"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#2D2D2D"
            android:padding="12dp"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etY"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="Y"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:background="#2D2D2D"
            android:padding="12dp"
            android:textSize="15sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnUsePicked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="用悬浮窗保存的坐标填充" />
</LinearLayout>
